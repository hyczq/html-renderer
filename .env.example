# 复制为 .env 后按需修改；docker compose 会自动读取。
# 注意：.env 已被 .gitignore 忽略，请勿提交。

# 页面标题 / 品牌名
BRAND_NAME=HTML 渲染器

# 预览页独立域名（强烈建议）
# 配置后：主站 /p/* 只做 302 跳转；预览域只提供只读页面，不暴露 API、不写 Cookie。
# 注意：必须是完整 Origin，例如 https://preview.example.com，不能带路径。
# PREVIEW_ORIGIN=https://preview.example.com

# 强制预览页 CSP sandbox（1/0）
# 未设置 PREVIEW_ORIGIN 时默认 1，且不允许设为 0；已有独立预览域名时默认 0。
# PREVIEW_SANDBOX=1

# 单页最大字节数（默认 2 MB）
MAX_PASTE_BYTES=2097152

# 是否信任 X-Forwarded-For / CF-Connecting-IP：
# 经 Nginx/Caddy/Cloudflare 反代时设为 1；直接暴露公网时设为 0
TRUST_PROXY=1

# 抓取远程 URL 的超时（毫秒）
FETCH_TIMEOUT_MS=12000

# 本地直接运行时的数据目录（Docker 内固定为 /data，由 compose 覆盖）
# DATA_DIR=./data
